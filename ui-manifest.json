{
  "$comment": "UI 包契约。桥在启动时读取本文件；字段缺失或版本不兼容时拒绝加载该 UI 包，而不是带着不确定的模板跑。",
  "uiVersion": "0.2.0",
  "protocolVersion": 1,
  "piBaseline": "0.85.1",
  "templates": {
    "shell": "templates/shell.html",
    "sessions": "templates/sessions.html",
    "history": "templates/history.html",
    "models": "templates/models.html",
    "packages": "templates/packages.html",
    "files": "templates/files.html",
    "extStatus": "templates/extensions/status.html",
    "extWidgets": "templates/extensions/widgets.html",
    "extDialog": "templates/extensions/dialog.html",
    "diff": "templates/diff.html",
    "_comment": "相对路径以 src/ 为基准；下划线开头的键是说明，不是模板"
  },
  "routes": {
    "shell": "/",
    "assets": "/assets/",
    "sessions": "/ui/sessions",
    "history": "/ui/sessions/{id}/history",
    "models": "/ui/models",
    "packages": "/ui/packages",
    "files": "/ui/files",
    "extStatus": "/ui/extensions/status",
    "extWidgets": "/ui/extensions/widgets",
    "extDialog": "/ui/extensions/dialog/{id}",
    "diff": "/ui/diff"
  },
  "requiredMethods": [
    "worker.list",
    "session.start",
    "session.state",
    "session.prompt",
    "session.abort",
    "session.subscribe",
    "session.unsubscribe",
    "sessions.search",
    "config.models",
    "config.models.write",
    "config.packages",
    "session.ui_response"
  ],
  "extensionChannel": {
    "fireAndForget": [
      "setStatus",
      "setWidget",
      "notify",
      "setTitle",
      "set_editor_text"
    ],
    "needsResponse": [
      "select",
      "confirm",
      "input",
      "editor"
    ],
    "unsupportedByRpc": [
      "setFooter",
      "setHeader",
      "setWorkingMessage",
      "setWorkingVisible",
      "setWorkingIndicator",
      "setHiddenThinkingLabel",
      "custom",
      "onTerminalInput",
      "addAutocompleteProvider",
      "setEditorComponent",
      "getEditorComponent",
      "pasteToEditor"
    ]
  },
  "build": {
    "_comment": "构建产物布局。桥只消费 dist/，不再读 src/assets。",
    "toolchain": "pnpm + Vite 7 + TypeScript 5 + Tailwind v4",
    "outputDir": "dist",
    "viteManifest": "dist/.vite/manifest.json",
    "entry": "src/entry/app.ts",
    "firstLoadBudgetGzipKB": 32
  },
  "assets": {
    "_comment": "构建后由 dist/.vite/manifest.json 解析真实文件名；这里只声明逻辑入口。",
    "entry": "app",
    "lazy": {
      "markdown": "marked",
      "highlight": "highlight.js",
      "math": "katex",
      "mermaid": "mermaid",
      "ansi": "ansi_up"
    }
  }
}
