# 依赖与产物（两个子目录各有自己的 .gitignore，此处只放仓库根级规则）
node_modules/
dist/
.next/
*.log
.DS_Store
*.tmp

# 运行期状态与本地配置
/deploy/
/backup-*/
# AI 编码助手的本地目录（计划、会话记录等），不进仓库
.zcode/
# Pi 插件的本地运行数据（例如 pi-goal-x 的 .pi/goals 目标文件与账本）
.pi/

# 编辑器
.idea/
.vscode/
*.swp
# 凭据与密钥：防止将来误提交（历史上从未出现过，此处是防御）
.env
.env.*
*.pem
*.key
*.crt
*.p12
credentials*.json
